#!/bin/sh
# Baked into the image at /usr/local/share/git-hooks and enabled by core.hooksPath
# in /etc/gitconfig, so every mode runs it and nothing is installed into the
# repo's .git/hooks. Runs the lefthook hook named after this file; to run
# another hook from lefthook.yml, link that name to this script in the Dockerfile.
# Repos without a lefthook config commit unhooked.
for config in lefthook.yml .lefthook.yml lefthook.yaml .lefthook.yaml; do
  if [ -e "$config" ]; then
    # --no-auto-install: lefthook would otherwise try to rewrite this root-owned hook.
    exec lefthook run "$(basename "$0")" --no-auto-install "$@"
  fi
done
exit 0
